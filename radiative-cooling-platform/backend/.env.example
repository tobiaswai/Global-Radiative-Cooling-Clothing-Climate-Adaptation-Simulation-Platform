# Database
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/radiative_cooling

# Security
SECRET_KEY=replace-with-a-random-secret
API_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With,Last-Event-ID
CORS_EXPOSE_HEADERS=Content-Disposition
CORS_ALLOW_CREDENTIALS=true

# Runtime
# Leave empty to use the operating system temporary directory.
NUMBA_CACHE_DIR=